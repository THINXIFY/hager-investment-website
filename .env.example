# Public contact details (shown on the site only once confirmed)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ---- Private documents: email verification (OTP) + delivery via Resend ----
# Server-only. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. HAGER INVESTMENT <documents@your-domain>
DOCUMENTS_FROM_EMAIL=
# Optional reply-to (defaults to NEXT_PUBLIC_CONTACT_EMAIL when set)
DOCUMENTS_REPLY_TO=
# Required in production: a long random secret (min. 16 chars), e.g. `openssl rand -hex 32`
OTP_HASH_SECRET=
# Optional tuning
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Optional paths (defaults: ./private/documents and ./.data/otp-challenges.json)
DOCUMENTS_DIR=
OTP_STORE_PATH=

# ---- Contact page enquiry form (sent via Resend; server-only) ----
# Inbox that receives enquiries (required to enable the form)
CONTACT_TO_EMAIL=
# Sender on a Resend-verified domain (defaults to DOCUMENTS_FROM_EMAIL)
CONTACT_FROM_EMAIL=
# Set to false to stop the acknowledgement email to the sender
CONTACT_SEND_ACK=true

# ---- Draft pages ----
# 1 = show draft pages (e.g. /impressum) for local/staging preview; leave unset in production
NEXT_PUBLIC_SHOW_DRAFTS=
