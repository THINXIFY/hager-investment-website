# HAGER INVESTMENT: production settings.
# On the VPS:  cp .env.production.example .env.production  &&  nano .env.production
# .env.production is git-ignored. Never commit it.

# ---- Public (built into the website; visible to visitors) ----
NEXT_PUBLIC_SITE_URL=https://hager-investment.com
NEXT_PUBLIC_CONTACT_EMAIL=info@hager-investment.com
NEXT_PUBLIC_CONTACT_PHONE=
# Leave these two EMPTY in production (they show draft pages / review markers):
NEXT_PUBLIC_SHOW_DRAFTS=
NEXT_PUBLIC_REVIEW_MODE=

# ---- Email delivery via Resend (server-only) ----
# API key from https://resend.com (domain hager-investment.com verified there)
RESEND_API_KEY=
# Sender for private documents, on the verified domain
DOCUMENTS_FROM_EMAIL=HAGER INVESTMENT <info@hager-investment.com>
DOCUMENTS_REPLY_TO=info@hager-investment.com

# ---- Contact page enquiry form ----
# Inbox that receives enquiries
CONTACT_TO_EMAIL=info@hager-investment.com
CONTACT_FROM_EMAIL=HAGER INVESTMENT <info@hager-investment.com>
CONTACT_SEND_ACK=true

# ---- Private documents (one-time email code) ----
# REQUIRED: a long random secret. Create one with:  openssl rand -hex 32
OTP_HASH_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Server ----
# Local port the website listens on (127.0.0.1 only). Change if 4300 is already used on the VPS.
HAGER_PORT=4300
